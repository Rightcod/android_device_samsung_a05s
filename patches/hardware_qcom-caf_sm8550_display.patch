+
+/* display hint flags*/
+#define DRM_MSM_DISPLAY_EARLY_WAKEUP_HINT         0x01
+#define DRM_MSM_DISPLAY_POWER_COLLAPSE_HINT       0x02
+#define DRM_MSM_DISPLAY_IDLE_TIMEOUT_HINT         0x04
