+
+	if (!width)
+		goto invalid_input;
+
+	switch (color_fmt) {
+	case MMM_COLOR_FMT_RGBA8888_UBWC:
+	case MMM_COLOR_FMT_RGBA1010102_UBWC:
+	case MMM_COLOR_FMT_RGB565_UBWC:
+		rgb_tile_width = 16;
+		break;
+	case MMM_COLOR_FMT_RGBA16161616F_UBWC:
+		rgb_tile_width = 8;
+		break;
