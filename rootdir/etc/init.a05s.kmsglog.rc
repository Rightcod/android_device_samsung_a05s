# Samsung Galaxy A05s Early Boot & HAL Initialization Fix

on early-init
    # Enable standard ADB security authorization check
    setprop ro.adb.secure 1
    # Disable auditd kmsg flooding
    setprop ro.logd.auditd false

    # Gralloc DMA-BUF heap configuration for Bengal (Linux 5.15 GKI)
    setprop vendor.gralloc.use_dma_buf_heaps 1
    setprop vendor.display.disable_layer_stitch 1
    setprop vendor.display.enable_perf_hint_large_comp_cycle 1

    # Bind mount system unified partitions to root mountpoints
    mkdir /product 0755 root root
    mkdir /system_ext 0755 root root
    mount none /system/product /product bind rec
    mount none /system/system_ext /system_ext bind rec

    # Set USB controller and configfs properties early
    setprop vendor.usb.controller 4e00000.dwc3
    setprop sys.usb.controller 4e00000.dwc3
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb
    setprop sys.usb.configfs 1

    # Telephony, VoLTE and Multi-SIM configuration
    setprop ro.vendor.multisim.simslotcount 2
    setprop ro.multisim.simslotcount 2
    setprop persist.radio.multisim.config dsds
    setprop ro.telephony.sim_slots.count 2
    setprop ro.telephony.default_network 9,9
    setprop ro.telephony.default_cdma_sub 0
    setprop telephony.lteOnCdmaDevice 0
    setprop ro.vendor.radio.default_network 9
    setprop ro.vendor.sec.radio.def_network 9
    setprop ro.build.version.oneui 70000

    # VoLTE and IMS configuration
    setprop persist.vendor.radio.volte 1
    setprop persist.vendor.radio.volte.enabled 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.radio.calls.on.ims 1
    setprop persist.vendor.radio.ims_enabled 1
    setprop persist.vendor.ims.feature 1
    setprop ro.telephony.ims.supported true
    setprop ro.vendor.telephony.ims.supported true

on property:ro.boot.singlecard=1
    setprop persist.radio.multisim.config ssss
    setprop ro.vendor.multisim.simslotcount 1
    setprop ro.multisim.simslotcount 1
    setprop ro.telephony.sim_slots.count 1

on property:ro.boot.simslotcount=1
    setprop persist.radio.multisim.config ssss
    setprop ro.vendor.multisim.simslotcount 1
    setprop ro.multisim.simslotcount 1
    setprop ro.telephony.sim_slots.count 1


on early-fs
    # Satisfy vendor init.target.rc wait_for_prop hwservicemanager.ready true
    setprop hwservicemanager.ready true
    setprop vendor.gralloc.use_dma_buf_heaps 1

on post-fs
    # Satisfy vendor init.target.rc wait_for_prop hwservicemanager.ready true
    setprop hwservicemanager.ready true

    # Re-assert bind mount system unified partitions to root mountpoints
    mount none /system/product /product bind rec
    mount none /system/system_ext /system_ext bind rec

    # Start binder context managers
    start hwservicemanager
    start vndservicemanager

    # Start early HALs and Keystore2 BEFORE mount_all --late is executed

    # USB properties
    setprop sys.usb.configfs 1
    setprop vendor.usb.controller 4e00000.dwc3
    setprop sys.usb.controller 4e00000.dwc3
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

    # Start logging userspace logcat (main, system, crash) to /dev/kmsg
    start a05s_kmsglog

on late-fs
    # Ensure properties and context managers are ready for late mounts
    setprop hwservicemanager.ready true
    start hwservicemanager
    start vndservicemanager

on post-fs-data
    # Prepare standard ADB keys directory (prompts user for RSA auth on device screen)
    mkdir /data/misc/adb 02750 system shell

    # Start display services
    start qti_display_boot
    start vendor.qti.hardware.display.allocator
    start vendor.qti.hardware.display.composer

    # Start sensors HAL service
    start vendor.sensors-hal-2-1-multihal

    # Start adbd early
    start adbd

    # Start Qualcomm / Samsung IMS daemons
    start vendor.imsdaemon
    start vendor.ims_rtp_daemon
    start vendor.qti.ims.daemon

on boot
    start vendor.sensors-hal-2-1-multihal
    start vendor.imsdaemon
    start vendor.ims_rtp_daemon
    start vendor.qti.ims.daemon

on property:sys.boot_completed=1
    setprop persist.sys.usb.config mtp,adb

service a05s_kmsglog /system/bin/a05s_kmsglog.sh
    user root
    group root system log
    disabled
